# ---- LLM key pool (never commit real keys) ----
# Assignment variable: comma-separated pool, ids are key_1, key_2 in this order.
# Here: key_1 = Gemini (primary), key_2 = Groq (fallback).
LLM_API_KEYS=
# Provider-specific variables (take precedence over LLM_API_KEYS for their slot):
GEMINI_API_KEY=
GROQ_API_KEY=
# LiteLLM model names (check your provider's current model list):
GEMINI_MODEL=gemini/gemini-2.5-flash
GROQ_MODEL=groq/llama-3.3-70b-versatile

# ---- Storage ----
DATABASE_URL=sqlite:////data/app.db

# ---- Web ----
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
VITE_API_BASE_URL=http://localhost:8000
# LLM_TIMEOUT_SECONDS=30
